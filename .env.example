# Names only; never put real values here. Real values live in your untracked .env (or the host's variable settings).

# ---- Read by `npm start` (core/app/env.ts) -----------------------------------------------------------------
# Postgres connection string (Railway provides this). Locally: postgresql://<you>@localhost:5432/bridge_recipes_dev
DATABASE_URL=
# Signing secret for incoming Shopify webhooks: the app's client secret, or for store-admin webhooks the signing key
# shown at Settings > Notifications > Webhooks. SHOPIFY_API_SECRET is accepted as a fallback name.
SHOPIFY_WEBHOOK_SECRET=
# 32-byte key (64 hex characters) that encrypts the stored Salesforce client secret.
# Generate locally with: openssl rand -hex 32   (losing it means re-entering the Salesforce credentials)
ENCRYPTION_KEY=
# Optional (defaults in brackets): database schema [bridge], listen address [0.0.0.0], port [8787],
# retention in days [sync log 30 / intake 14 / entity map 30 / compliance log 365], purge interval in minutes [360], worker poll seconds [2], shutdown timeout seconds [20].
BRIDGE_SCHEMA=
HOST=
PORT=
RETENTION_SYNC_LOG_DAYS=
RETENTION_INTAKE_DAYS=
RETENTION_ENTITY_MAP_DAYS=
RETENTION_COMPLIANCE_DAYS=
PURGE_EVERY_MINUTES=
WORKER_POLL_SECONDS=
SHUTDOWN_TIMEOUT_SECONDS=
# Operator password for the admin UI at /admin (at least 12 characters). Leave empty to switch the admin UI OFF.
ADMIN_PASSWORD=
# Set to true ONLY when a reverse proxy you control (Railway, nginx) terminates TLS in front of the service: then the admin login limiter
# uses the real client address (X-Real-IP, else the last X-Forwarded-For entry; test with a spoofed header after deploying) and the session cookie is marked Secure. Leave empty when the service is reached directly.
TRUSTED_PROXY=

# ---- Read by `scripts/admin.ts connect <shop>` (stores the Salesforce connection ENCRYPTED) -------------------
# My Domain URL of the Salesforce org, then the External Client App consumer key and secret (client credentials flow).
# Also used by the one-time research scripts in scripts/ (org-checks, permission-checks, worker-smoke, spike).
SF_LOGIN_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# The Shopify app's client id (public, not a secret). Set it to switch ON the embedded /app page inside the Shopify admin
# (docs/EMBEDDED_UI.md); leave empty and /app does not exist. Only shops the operator has added may use it.
SHOPIFY_API_KEY=

# ---- PLANNED: not read by anything yet (App Store phase) ------------------------------------------------------
SHOPIFY_APP_URL=
SCOPES=
