# Example Shopify app configuration for Bridge Recipes.
#
# Copy this file to `shopify.app.toml` (that file is git-ignored on purpose: it carries YOUR app's client id and YOUR
# host) and fill in the two placeholders below. `shopify app config link` can also write the real file for you.
# Nothing secret belongs here: the client SECRET stays in the service's SHOPIFY_WEBHOOK_SECRET variable, never in a file.
# Reference: https://shopify.dev/docs/apps/tools/cli/configuration

client_id = "<your app's client id>"            # from your app in the Shopify Dev Dashboard (not a secret)
name = "<your app name>"
application_url = "https://shopify.dev/apps/default-app-home"
embedded = false

[webhooks]
api_version = "2026-10"

  # One subscription for every topic the service handles. The host must be publicly reachable over HTTPS.
  [[webhooks.subscriptions]]
  uri = "https://<your-host>/webhooks/shopify"
  compliance_topics = [ "customers/data_request", "customers/redact", "shop/redact" ]
  topics = [ "app/uninstalled", "orders/paid" ]

[access_scopes]
# Request only what the enabled recipe needs. R1 needs read_orders; the customer's name and email that come with an
# order also need protected customer data access, which is a separate Shopify step.
scopes = "read_orders"
optional_scopes = [ ]
use_legacy_install_flow = false

[auth]
redirect_urls = [ ]
