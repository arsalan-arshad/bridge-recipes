# Names only; never put real values here. Copy to .env.staging (git-ignored). Use values of a SEPARATE staging Shopify app and a
# DIFFERENT encryption key from production. DATABASE_URL is set by docker-compose.staging.yml and must not be put here.
# The staging app's client secret (signs webhooks and session tokens). NOT the production app's secret.
SHOPIFY_WEBHOOK_SECRET=
# 32-byte key, 64 hex characters (openssl rand -hex 32). A new one: never reuse production's.
ENCRYPTION_KEY=
# The staging Shopify app's client id; switches on /app.
SHOPIFY_API_KEY=
# Optional: operator password for /admin (12+ characters).
ADMIN_PASSWORD=
# Optional: let any store register itself (staging only).
OPEN_REGISTRATION=true
